# Target profile for build-tools.sh: Raspberry Pi 4B on 64-bit Raspberry Pi
# OS. The ".2.36" floor is Bookworm's glibc; the builds also run on newer
# ones (Trixie, 2.41).
PROFILE_ARCH=aarch64
RUST_TARGET=aarch64-unknown-linux-gnu.2.36
RUST_CPU=cortex-a72
GO_ENV="GOARCH=arm64 CGO_ENABLED=0"
NEEDS_SDK=0
DETECT_CPU_PART=0xd08

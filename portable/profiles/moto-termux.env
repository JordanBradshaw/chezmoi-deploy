# Target profile for build-tools.sh: Termux on the moto g power 2026
# (MediaTek MT6835: 2x Cortex-A76 + 6x Cortex-A55, Android 16). cortex-a55
# runs on both core types. cargo-zigbuild can't target Android: the NDK
# links instead (API 24 is Termux's minimum). Go builds with cgo, whose
# resolver works without /etc/resolv.conf. Only crate: and go: rows ship;
# pkg covers the rest. Never picked by zssh (no DETECT_* field).
PROFILE_ARCH=aarch64
RUST_TARGET=aarch64-linux-android
RUST_CPU=cortex-a55
GO_ENV="GOOS=android GOARCH=arm64 CGO_ENABLED=1"
NEEDS_SDK=0
CARGO_DRIVER=ndk
ANDROID_API=24
NATIVE_ONLY=1

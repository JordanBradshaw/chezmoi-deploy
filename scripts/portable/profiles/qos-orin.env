# Target profile for build-tools.sh: Jetson Orin NX on Quantum-Systems OS
# (Yocto, glibc 2.39). zigbuild's ".2.39" suffix keeps glibc symbol versions
# at or below the target's; cross: recipes need the Yocto SDK (/opt/nos).
PROFILE_ARCH=aarch64
RUST_TARGET=aarch64-unknown-linux-gnu.2.39
RUST_CPU=cortex-a78ae
GO_ENV="GOARCH=arm64 CGO_ENABLED=0"
NEEDS_SDK=1
